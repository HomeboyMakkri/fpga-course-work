# Microsoft Office temporary lock files
~$*.docx

# Local revision archives generated by Altium Designer
**/History/
**/Project Logs for */
**/Project Outputs for */
*.PrjPcbStructure

# Private runtime state of the local Altium MCP
tools/altium/.venv/
tools/altium/runtime/
tools/altium/bridge_config.json
tools/altium/__pycache__/
**/__pycache__/
*.py[cod]

# Intermediate copies created while generating published Altium reports
output/altium/**/backups/

# Gowin IDE build artefacts and per-user project settings
gowin/fpga_project/impl/
gowin/fpga_project/*.gprj.user

# Local scratch files
tmp/

# Diagnostics generated by local tools
*.log
